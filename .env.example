# Badminton Dataset Generator — Environment Variables

# Backend
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Data directories (relative to project root)
DATA_DIR=data
VIDEOS_DIR=data/videos
FRAMES_DIR=data/frames
EXPORTS_DIR=data/exports

# Image quality thresholds
MIN_RESOLUTION_WIDTH=640
MIN_RESOLUTION_HEIGHT=360
BLUR_THRESHOLD=100.0
BLACK_FRAME_THRESHOLD=10.0

# Duplicate detection
PHASH_SIMILARITY_THRESHOLD=8

# Video processing defaults
DEFAULT_EXTRACTION_INTERVAL=2
DEFAULT_MAX_RESOLUTION=1080
JPEG_QUALITY=95
